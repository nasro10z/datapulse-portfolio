# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Env / credentials — never commit
.env

# Bases SQLite locales — recréées au démarrage / par l'ETL.
# `backend/data/*` (et non `backend/data/`) : git ne peut pas ré-inclure un fichier
# dont le dossier parent est exclu, or on veut versionner l'export gold ci-dessous.
backend/data/*

# Exception : le gold exporté (~1 Mo) est **versionné** — c'est l'unique donnée
# embarquée dans un déploiement en lecture seule (l'API ne lit rien d'autre).
# Régénéré par `python -m app.etl.export_gold --shift-to-now` après chaque
# exécution du pipeline, puis recommitté.
!backend/data/datapulse_gold.db

# Données sources brutes (fournies manuellement, volumineuses) — ne pas committer.
# À déposer dans backend/app/ml/data/raw/ (voir docs/ml-data-integration.md).
backend/app/ml/data/

# Node
node_modules/
dist/

# Editor / OS
.vscode/
.idea/
Thumbs.db

# Config machine-locale (launch.json contient des chemins absolus)
.claude/

# Table de correspondance d'anonymisation — la publier annulerait l'anonymisation
.anonymization-map.local.md
.ROADMAP.md
.SESSION.md
